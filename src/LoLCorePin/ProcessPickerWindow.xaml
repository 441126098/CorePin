<Window x:Class="LoLCorePin.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查找游戏进程 · LoLCorePin" Width="760" Height="560" MinWidth="620" MinHeight="400" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="从 WeGame 进入训练或对局后刷新；找到实际游戏 .exe，再加入监视列表。这里仅列举进程名称，不读取程序文件。" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <DockPanel Grid.Row="1" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="刷新" Click="Refresh_Click"/>
      <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="按进程名、PID 或父进程 PID 筛选" AutomationProperties.Name="筛选正在运行的进程" Margin="0,0,8,0"/>
    </DockPanel>
    <DataGrid x:Name="ProcessGrid" Grid.Row="2" IsReadOnly="True" MouseDoubleClick="Process_DoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="进程文件名" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="90"/>
        <DataGridTextColumn Header="父进程 PID" Binding="{Binding ParentId}" Width="110"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="加入监视列表" Style="{StaticResource PrimaryButton}" Click="Choose_Click"/>
      <Button DockPanel.Dock="Right" Content="取消" IsCancel="True"/>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
