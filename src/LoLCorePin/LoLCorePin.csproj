<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LoLCorePin</AssemblyName>
    <RootNamespace>LoLCorePin</RootNamespace>
    <Version>1.0.0</Version>
    <Description>原创 Windows LOL 性能核绑定工具</Description>
    <ApplicationIcon>Assets\LoLCorePin.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\LoLCorePin.ico" />
  </ItemGroup>
</Project>
