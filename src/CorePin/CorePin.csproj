<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CorePin</AssemblyName>
    <RootNamespace>CorePin</RootNamespace>
    <Version>1.0.0</Version>
    <Product>CorePin</Product>
    <Title>CorePin</Title>
    <Authors>CorePin contributors</Authors>
    <Copyright>Copyright (c) 2026 CorePin contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Windows 游戏进程性能核绑定工具，使用公开 Windows API。</Description>
    <ApplicationIcon>Assets\CorePin.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\CorePin.ico" />
  </ItemGroup>
</Project>
